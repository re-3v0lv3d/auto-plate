# auto-info.gratis
AUTOINFO_BASE=https://auto-info.gratis
AUTOINFO_LANG=es
# Credenciales de la cuenta profesional (opcional). Sin ellas se usa el flujo web.
AUTOINFO_PIN=
AUTOINFO_ACCESS=
AUTOINFO_ACTION=check
# site (gratis) | solver (2captcha)
AUTOINFO_CAPTCHA_MODE=site
AUTOINFO_TIMEOUT=25

# Captcha: site | manual | 2captcha | none
#   site     = replica la petición del navegador (por defecto)
#   manual   = exige token real del cliente (API)
#   2captcha = resuelve en servidor reCAPTCHA y Turnstile (CAPTCHA_API_KEY)
CAPTCHA_PROVIDER=site
CAPTCHA_API_KEY=
CAPTCHA_SITEKEY=6LedQaYoAAAAAOxmjCgIZNM1ANwQ1sQfvLtYDFhi

# Almacenamiento: sqlite | firestore
STORAGE=sqlite
DB_PATH=data/vehicles.db
# Firestore (solo si STORAGE=firestore). En Cloud Run se detecta solo.
GCP_PROJECT=
FIRESTORE_PREFIX=
CACHE_TTL_DAYS=30

# Servidor
# Protección de la API (obligatorio si publicas el frontend). Vacío = sin auth.
# No pongas estas credenciales en el repositorio: van por entorno.
API_USER=
API_PASSWORD=
ALLOW_WEB_PROVIDER=1
RATE_LIMIT_PER_MINUTE=20
